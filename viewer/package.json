{
  "name": "email-shoebox-viewer",
  "version": "0.1.0",
  "description": "The Email Shoebox viewer: a familiar, local-only interface for email archives made by the importer.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "email-shoebox": "scripts/start.ts"
  },
  "scripts": {
    "start": "node scripts/start.ts",
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dompurify": "3.4.16",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
