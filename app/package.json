{
  "name": "email-shoebox",
  "productName": "Email Shoebox",
  "version": "0.1.1",
  "description": "Keep your old emails in a shoebox: import a Gmail backup and read it in a familiar interface, all on your own computer.",
  "author": "dkurth",
  "homepage": "https://github.com/dkurth/email-shoebox",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "start": "node scripts/build.ts && electron .",
    "fetch-python": "node scripts/fetch-python.ts",
    "dist": "node scripts/dist.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.4",
    "@playwright/test": "1.64.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
